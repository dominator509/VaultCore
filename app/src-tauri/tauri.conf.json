{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VaultCore",
  "version": "0.1.0",
  "identifier": "com.vaultcore.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VaultCore",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "VaultCore",
    "copyright": "Copyright (c) VaultCore contributors",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
